# Copiar como .env y completar. Nunca subir el .env al repositorio.
# Carpeta de datos (base, fotos, backups). Por defecto: ./datos
CIRCULARIS_DATA_DIR=C:/Circularis/datos
# Dirección fija de la mini PC en la red local (va en los QR)
CIRCULARIS_URL_BASE=http://192.168.0.10:8501
# Clave para firmar la cookie de sesión: una frase larga y secreta
CIRCULARIS_CLAVE_COOKIE=cambiar-por-una-frase-larga-y-secreta
CIRCULARIS_DIAS_COOKIE=30
# Correo saliente (opcional: sin esto las alertas quedan solo en el panel)
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
